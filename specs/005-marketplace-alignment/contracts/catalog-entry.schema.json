{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/speckit-superpowers-bridge/catalog-entry.schema.json",
  "title": "Spec Kit Community Catalog Entry",
  "description": "Validates a single entry destined for extensions/catalog.community.json in github/spec-kit.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "description",
    "author",
    "version",
    "license",
    "repository",
    "download_url",
    "requires",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "download_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "documentation": {
      "type": "string",
      "format": "uri"
    },
    "changelog": {
      "type": "string",
      "format": "uri"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speckit_version"],
      "properties": {
        "speckit_version": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": { "type": "integer", "minimum": 0 },
        "hooks": { "type": "integer", "minimum": 0 }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "verified": { "type": "boolean" },
    "downloads": { "type": "integer", "minimum": 0 },
    "stars": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
